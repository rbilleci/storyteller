# Export values in your shell; the application does not automatically load .env.
# Paths are relative to the checkout unless you supply absolute paths.
# For a persistent campaign, default root is the checkout.
# BSH_CAMPAIGN_ROOT=/absolute/path/to/campaign-root
# BSH_SERVER_PYTHON=/absolute/path/to/checkout/.venv/bin/python
# NARRATOR_PYTHON=/absolute/path/to/checkout/.narrator-venv/bin/python

# A separately running model endpoint; no server is started by the application.
# BSH_LLM_BASE_URL=http://localhost:8000/v1
# BSH_LLM_MODEL=google/gemma-4-26B-A4B-it

# Structured decision rounds; zero selects narration without decision planning.
# BSH_DECISION_ROUNDS=2

# Romantic escalation also requires recorded session policy and player consent.
# BSH_ROMANCE_ESCALATION=0

# Out-of-fiction address marker, without @ or whitespace.
# BSH_GM_ADDRESS=GM

# Catalog and narration language; /language changes it during a session.
# BSH_LANGUAGE=en-US

# Channel-agent thinking only; other structured calls do not think.
# BSH_TURN_THINKING=low
# BSH_TURN_THINKING_BUDGET_LOW=250
# BSH_TURN_THINKING_BUDGET_MEDIUM=1000
# BSH_TURN_THINKING_BUDGET_HIGH=2500

# Server diagnostics use stderr only.
# BSH_DEBUG=1

# Reproducible demonstrations only; leave unset for normal play.
# BSH_SEED=1234

# Standalone regression probes: a fresh directory and optional serving-script hash.
# BSH_PROBE_RUN_DIRECTORY=/absolute/path/to/empty-probe-directory
# BSH_MODEL_LAUNCHER=/absolute/path/to/your-model-launcher.sh
