  },
  "required": [
    "route",
    "hazard",
    "social_category",
    "social_mode",
    "trade_phase",
    "named_person_ids",
    "names_unrecorded_person",
    "interlocutor_id",
    "accepts_offer",
    "offered_price",
    "departs",
    "bare_answer",
    "replies_to_question",
    "defence_method",
    "reads_by_observing",
    "romance_escalation",
    "romance_coercive",
    "reason"
  ],
  "title": "TurnClassification",
  "type": "object"
